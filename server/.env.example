NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/oot?appName=CLUSTER
MONGODB_DATABASE=oot
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
